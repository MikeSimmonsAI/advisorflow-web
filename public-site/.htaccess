DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404.html

# ── APPLICANT DATA IS NEVER SERVED, WHATEVER ELSE IS MISCONFIGURED ──────────
#
# storage/ and private/ each carry their own "Require all denied" .htaccess,
# and those are the primary control. This is a second, independent one, because
# the primary depends on the host having AllowOverride enabled for those
# directories - and the thing it protects is real people's names, phone numbers
# and resumes. A single misconfiguration should not be enough to publish them.
#
# BEST PRACTICE FOR PRODUCTION, and the reason this block says "whatever else":
# set CAREERS_STORAGE_DIR in private/config.php to a directory ABOVE
# public_html. Then applicant data is not under the document root at all and no
# web-server rule has to be right for it to stay private.
<FilesMatch "\.(json|pdf|doc|docx)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
# sitemap.xml and robots.txt are public by design and are not matched above.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
