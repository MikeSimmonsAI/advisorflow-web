# The lockfile in this directory was RESOLVED under legacy peer rules, so every
# install of it has to be, including the one EAS Build runs on its own machine.
#
# The Expo 57 template pulls react-dom@19.3.0 (peer react@^19.3.0) alongside
# react@19.2.3, and @testing-library/react-native pulls react-test-renderer
# (peer react@^19.2.8). npm's strict resolver refuses that tree. Locally the
# refusal is worked around with `npm install --legacy-peer-deps`; the EAS
# builder runs a fixed `npm ci --include=dev` and passes no flags, so without
# this file it fails in the Install dependencies phase before a single line of
# the app is compiled. Build 4254c428 died there in nine seconds.
#
# This is configuration of a pre-existing template conflict, not a licence to
# ignore peer ranges generally: it must be revisited whenever the Expo SDK is
# upgraded, and deleted the moment the template's react/react-dom versions agree.
legacy-peer-deps=true
