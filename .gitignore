# Production data snapshots - contain real org names and user emails. Repo is public.
scripts/*.json
scripts/god_snapshot.json
deploy_log.txt

# Local Sales Workspace demo database (scripts/demo_local_scheduling.py).
# Development fixture only - never production data.
demo_sales.db

# Local sales-execution demo database (scripts/demo_env.py), used to drive the
# UI for screenshots. Development fixture only - never production data.
demo_local.db

# Local Demo Mode database (scripts/demo_local.bat). Holds only synthetic
# scenario data with reserved 555-01xx numbers and example.com addresses, but
# it is still a database file and has no business in the repository.
demo_env.db
demo_firewall_test.db
# Checkpoint 6 staging scratch (tarballs used to move source to a test box)
.cp6tmp/
cp6_local.db
cp6check.db

# SQLite rollback journals / WAL from local test runs
*.db-journal
*.db-wal
*.db-shm

# perf benchmark outputs (machine-specific, not source)
.perfdump/
perf_baseline_*.json
perf_after_*.json
app/routers/sales_router.optimized.bak
